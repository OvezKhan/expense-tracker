{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",

  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node"
    }
  },

  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}